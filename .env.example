# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
# Comma-separated browser origins allowed to call the API (native Android uses https://localhost).
APP_ALLOWED_ORIGINS=https://your-public-website.example
# From Razorpay Dashboard > Settings > API Keys (use Test keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Where orders/stores are saved. On Render/Railway point this to a persistent disk path.
DATA_FILE=./data.json

# Admin panel password (choose a strong one). Leave empty to disable admin.
ADMIN_PASSWORD=choose-a-strong-password

# true = 3 demo stores + 3 demo delivery partners (PIN 1234) for testing.
# Set false before real launch, or remove them from Admin panel.
SEED_DEMO=true
